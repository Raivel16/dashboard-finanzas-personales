{
  "name": "dashboard-finanzas-personales",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard de Finanzas Personales (MERN)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm test -w shared && npm test -w server && npm test -w client",
    "build": "npm run build -w client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cobertura": "node server/scripts/cobertura-escenarios.js",
    "cobertura:comprobar": "node server/scripts/cobertura-escenarios.js --comprobar"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
