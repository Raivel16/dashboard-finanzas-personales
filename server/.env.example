# Copia este archivo como server/.env y completa los valores marcados. server/.env no se versiona.

NODE_ENV=development
PORT=3000

# MongoDB como replica set (necesario para transacciones). Ver README: "MongoDB local como replica set".
# Para usar Atlas basta cambiar solo esta URI por la de tu clúster (mongodb+srv://...).
MONGODB_URI=mongodb://127.0.0.1:27017/finanzas?directConnection=true

# Origen del cliente (CORS). En desarrollo es el servidor de Vite.
CLIENT_URL=http://localhost:5173

# Secreto de los tokens de acceso: mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Opcionales (valores por defecto entre paréntesis)
# JWT_ACCESS_TTL=15m
# REFRESH_INACTIVITY_MIN=30
# REFRESH_ABSOLUTE_DAYS=7
# RESET_TOKEN_TTL_MIN=30
# APP_TIMEZONE=America/Lima

# Correo (obligatorio en producción). Sin SMTP_HOST el correo se escribe en el log, sin enviarse.
# Si defines SMTP_HOST, también son obligatorios SMTP_USER, SMTP_PASS y MAIL_FROM.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# Solo para `npm run seed:admin -w server` (primer administrador). Bórralos después de usarlos.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Solo para `npm run seed -w server`: contraseña de los usuarios demo (por defecto Demo1234).
# SEED_PASSWORD=
